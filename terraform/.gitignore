# Local .terraform directories and state – never commit these.
.terraform/
.tools/
*.tfstate
*.tfstate.*
crash.log
crash*.log

# Variable files may contain secrets (the .example files stay tracked).
*.tfvars
*.tfvars.json
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
